# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_irrigation
DB_USER=postgres
DB_PASSWORD=

# Required in deployment; use the same high-entropy value for Express and FastAPI.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
FRONTEND_ORIGIN=http://localhost:3001
# Production split-domain deployments need HTTPS; defaults to SameSite=None there.
COOKIE_SAME_SITE=lax

# Optional live weather and translation providers
OPENWEATHER_API_KEY=
SARVAM_API_KEY=

# Optional outbound notifications (only sent when farmer preferences opt in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional Web Push; generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
